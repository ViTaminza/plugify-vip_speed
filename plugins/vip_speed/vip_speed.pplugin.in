{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${VIP_SPEED_VERSION}",
	"name": "vip_speed",
	"description": "[VIP] Speed: writes the 'speed' feature value of a VIP's group (a decimal in [0.1, 2.0]) into the pawn's m_flVelocityModifier when the player spawns. Ported from the Pisex VIP core module VIP_Speed (vip_speed). Requires the vip core.",
	"author": "ABKAM, ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/vip_speed",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.2"
		},
		{
			"name": "vip",
			"constraints": ">=1.0.0"
		},
		{
			"name": "hudmenu",
			"constraints": ">=1.0.0",
			"optional": true
		}
	]
}
